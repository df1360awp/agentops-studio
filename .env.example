# Default: no fabricated business data. Import your own CSV/JSON to populate the dashboard.
AGENTOPS_SEED_SAMPLE=0
# Where SQLite data is stored (the directory must be writable).
AGENTOPS_DB_PATH=./data/studio.sqlite3
# Set a strong random value before allowing any non-local traffic.
# AGENTOPS_API_TOKEN=put-a-random-32-byte-secret-here
# Optional LLM API. Data will leave this server if you enable it.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_MODEL=your-available-model
